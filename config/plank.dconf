# =============================================================================
# SharkOS — Configuration Plank Dock (style macOS)
# À importer avec : dconf load /net/launchpad/plank/ < plank.dconf
# =============================================================================

[docklets/]

[docklets/Clock]
driver='Clock'
show-seconds=false

[docks/dock1]
# Position du dock (bas de l'écran)
position='bottom'

# Alignement centré
alignment='center'

# Masquage automatique intelligent
hide-mode='intellihide'
unhide-delay=0
hide-delay=300

# Taille des icônes (style macOS)
icon-size=48

# Zoom au survol (effet macOS)
zoom-enabled=true
zoom-percent=150

# Thème du dock
theme='Transparent'

# Verrouillage des éléments (pas de suppression accidentelle)
lock-items=false

# Offset vertical
offset=6

# Moniteur principal
monitor=''

# Éléments épinglés par défaut
items-filename=['nautilus.dockitem', 'thunar.dockitem', 'firefox-esr.dockitem', 'xfce4-terminal.dockitem', 'mousepad.dockitem', 'wireshark.dockitem']
