KEYBOARDS = [
    ("🇫🇷  Français — AZERTY", "fr"),
    ("🇺🇸  English — US QWERTY", "us"),
    ("🇬🇧  English — UK QWERTY", "gb"),
    ("🇩🇪  Deutsch — QWERTZ", "de"),
    ("🇪🇸  Español — QWERTY", "es"),
    ("🇮🇹  Italiano — QWERTY", "it"),
    ("🇵🇹  Português — QWERTY", "pt"),
    ("🇧🇪  Belge — AZERTY", "be"),
    ("🇨🇭  Suisse — QWERTZ", "ch"),
]


class SharkOSSetupWizard(Gtk.Window):
    def __init__(self):
        super().__init__(title="SharkOS")
        self.set_default_size(900, 620)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_decorated(False)          # Fenêtre sans chrome natif
        self.fullscreen()

        # Appliquer le CSS
        css = Gtk.CssProvider()
        css.load_from_data(CSS_STYLE)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.selected_layout = "fr"
        self.username = ""
        self.password = ""
        self._pulse_active = False
        self._countdown = 3

        # ── Structure ──────────────────────────────────────────────────
        # Couche de fond avec overlay de lumière
        overlay = Gtk.Overlay()
        self.add(overlay)

        bg = Gtk.EventBox()
        overlay.add(bg)

        glow = Gtk.Box()
        glow.get_style_context().add_class("glass-overlay")
        glow.set_halign(Gtk.Align.FILL)
        glow.set_valign(Gtk.Align.FILL)
        overlay.add_overlay(glow)

        # Centrage de la card
        center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        center.set_valign(Gtk.Align.CENTER)
        center.set_halign(Gtk.Align.CENTER)
        overlay.add_overlay(center)

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.card.get_style_context().add_class("glass-card")
        self.card.set_size_request(740, -1)
        center.pack_start(self.card, False, False, 0)

        # Stack de pages
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(380)
        self.card.pack_start(self.stack, True, True, 0)

        self._build_welcome()
        self._build_keyboard()
        self._build_user()
        self._build_loading()
        self._build_done()

        self.stack.set_visible_child_name("welcome")
        self.show_all()

    # ── Helpers ───────────────────────────────────────────────────────

    def _logo_widget(self, size=96):
        """Charge wallpapers/sharkos-logo.png (copié en /usr/share/sharkos/logo.png)."""
        for path in (LOGO_PATH, "/usr/share/sharkos/logo.png", "wallpapers/sharkos-logo.png"):
            if os.path.exists(path):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size)
                    img = Gtk.Image.new_from_pixbuf(pb)
                    img.set_halign(Gtk.Align.CENTER)
                    return img
                except Exception:
                    pass
        # Fallback emoji si fichier absent
        lbl = Gtk.Label(label="🦈")
        lbl.modify_font(Pango.FontDescription(f"Sans {size // 10 * 8}"))
        lbl.set_halign(Gtk.Align.CENTER)
        return lbl

    def _dots(self, active=-1, total=3):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_halign(Gtk.Align.CENTER)
        for i in range(total):
            lbl = Gtk.Label(label="●")
            lbl.get_style_context().add_class("dot-active" if i == active else "dot-inactive")
            box.pack_start(lbl, False, False, 0)
        return box

    def _sep(self):
        s = Gtk.Box()
        s.set_size_request(-1, 1)
        s.get_style_context().add_class("glass-sep")
        return s

    def _field(self, label_text, widget, error_lbl=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        lbl = Gtk.Label(label=label_text)
        lbl.get_style_context().add_class("field-label")
        lbl.set_halign(Gtk.Align.START)
        box.pack_start(lbl, False, False, 0)
        box.pack_start(widget, False, False, 0)
        if error_lbl:
            box.pack_start(error_lbl, False, False, 0)
        return box

    def _nav(self, back_cb=None, fwd_btn=None):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_halign(Gtk.Align.END)
        if back_cb:
            b = Gtk.Button(label="← Retour")
            b.get_style_context().add_class("btn-secondary")
            b.connect("clicked", back_cb)
            box.pack_start(b, False, False, 0)
        if fwd_btn:
            box.pack_start(fwd_btn, False, False, 0)
        return box

    def _go(self, name):
        self.stack.set_visible_child_name(name)

    # ── Pages ─────────────────────────────────────────────────────────

    def _build_welcome(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)

        # Logo depuis wallpapers/sharkos-logo.png
        logo = self._logo_widget(size=120)
        box.pack_start(logo, False, False, 0)

        title = Gtk.Label(label="Bienvenue dans SharkOS")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.CENTER)
        box.pack_start(title, False, False, 0)

        sub = Gtk.Label(label="Ton système va être configuré en 3 étapes simples.\nCela prend moins d'une minute.")
        sub.get_style_context().add_class("page-subtitle")
        sub.set_justify(Gtk.Justification.CENTER)
        sub.set_halign(Gtk.Align.CENTER)
        box.pack_start(sub, False, False, 0)

        box.pack_start(self._dots(-1), False, False, 4)
        box.pack_start(self._sep(), False, False, 4)

        btn = Gtk.Button(label="Commencer  →")
        btn.get_style_context().add_class("btn-primary")
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_: self._go("keyboard"))
        box.pack_start(btn, False, False, 8)

        self.stack.add_named(box, "welcome")

    def _build_keyboard(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        logo_small = self._logo_widget(size=36)
        header.pack_start(logo_small, False, False, 0)
        title = Gtk.Label(label="Disposition du clavier")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.START)
        header.pack_start(title, True, True, 0)
        box.pack_start(header, False, False, 0)

        sub = Gtk.Label(label="Choisis le layout qui correspond à ton clavier physique.\nTu peux le modifier plus tard dans les Préférences système.")
        sub.get_style_context().add_class("page-subtitle")
        sub.set_halign(Gtk.Align.START)
        box.pack_start(sub, False, False, 0)

        box.pack_start(self._sep(), False, False, 4)

        self.combo = Gtk.ComboBoxText()
        for name, code in KEYBOARDS:
            self.combo.append(code, name)
        self.combo.set_active(0)
        self.combo.connect("changed", self._on_layout_changed)
        box.pack_start(self._field("Langue / Layout", self.combo), False, False, 0)

        # Badge affichant le code actuel
        badge_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        badge_row.set_halign(Gtk.Align.START)
        badge_lbl_prefix = Gtk.Label(label="Sélectionné :")
        badge_lbl_prefix.get_style_context().add_class("page-subtitle")
        badge_row.pack_start(badge_lbl_prefix, False, False, 0)
        self.lbl_badge = Gtk.Label(label="fr")
        self.lbl_badge.get_style_context().add_class("badge")
        badge_row.pack_start(self.lbl_badge, False, False, 0)
        box.pack_start(badge_row, False, False, 0)

        box.pack_start(self._dots(0), False, False, 8)

        btn = Gtk.Button(label="Continuer  →")
        btn.get_style_context().add_class("btn-primary")
        btn.connect("clicked", lambda *_: self._go("user"))
        box.pack_start(self._nav(
            back_cb=lambda *_: self._go("welcome"),
            fwd_btn=btn,
        ), False, False, 4)

        self.stack.add_named(box, "keyboard")

    def _on_layout_changed(self, combo):
        self.selected_layout = combo.get_active_id() or "fr"
        self.lbl_badge.set_text(self.selected_layout)
        subprocess.run(["setxkbmap", self.selected_layout], capture_output=True)

    def _build_user(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        logo_small = self._logo_widget(size=36)
        header.pack_start(logo_small, False, False, 0)
        title = Gtk.Label(label="Créer ton compte")
        title.get_style_context().add_class("page-title")
        header.pack_start(title, True, True, 0)
        box.pack_start(header, False, False, 0)

        sub = Gtk.Label(label="Ce compte aura les droits administrateur (sudo).\nTu pourras en créer d'autres dans les réglages.")
        sub.get_style_context().add_class("page-subtitle")
        sub.set_halign(Gtk.Align.START)
        box.pack_start(sub, False, False, 0)

        box.pack_start(self._sep(), False, False, 4)

        # Nom d'utilisateur
        self.entry_user = Gtk.Entry()
        self.entry_user.set_placeholder_text("Ex : sharky")
        self.err_user = Gtk.Label()
        self.err_user.get_style_context().add_class("error-label")
        self.err_user.set_halign(Gtk.Align.START)
        box.pack_start(self._field("Nom d'utilisateur", self.entry_user, self.err_user), False, False, 0)

        # Mot de passe avec œil
        pass_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.entry_pass = Gtk.Entry()
        self.entry_pass.set_visibility(False)
        self.entry_pass.set_placeholder_text("Mot de passe")
        pass_row.pack_start(self.entry_pass, True, True, 0)
        eye1 = Gtk.Button(label="👁")
        eye1.get_style_context().add_class("btn-eye")
        eye1.set_tooltip_text("Afficher / masquer")
        eye1.connect("clicked", lambda *_: self.entry_pass.set_visibility(not self.entry_pass.get_visibility()))
        pass_row.pack_start(eye1, False, False, 0)
        self.err_pass = Gtk.Label()
        self.err_pass.get_style_context().add_class("error-label")
        self.err_pass.set_halign(Gtk.Align.START)
        box.pack_start(self._field("Mot de passe", pass_row, self.err_pass), False, False, 0)

        # Confirmation
        conf_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.entry_conf = Gtk.Entry()
        self.entry_conf.set_visibility(False)
        self.entry_conf.set_placeholder_text("Répéter le mot de passe")
        conf_row.pack_start(self.entry_conf, True, True, 0)
        eye2 = Gtk.Button(label="👁")
        eye2.get_style_context().add_class("btn-eye")
        eye2.connect("clicked", lambda *_: self.entry_conf.set_visibility(not self.entry_conf.get_visibility()))
        conf_row.pack_start(eye2, False, False, 0)
        self.err_conf = Gtk.Label()
        self.err_conf.get_style_context().add_class("error-label")
        self.err_conf.set_halign(Gtk.Align.START)
        box.pack_start(self._field("Confirmer le mot de passe", conf_row, self.err_conf), False, False, 0)

        box.pack_start(self._dots(1), False, False, 4)

        btn = Gtk.Button(label="Finaliser l'installation  →")
        btn.get_style_context().add_class("btn-primary")
        btn.connect("clicked", self._on_finish)
        box.pack_start(self._nav(
            back_cb=lambda *_: self._go("keyboard"),
            fwd_btn=btn,
        ), False, False, 0)

        self.stack.add_named(box, "user")

    def _clear_errors(self):
        for e in (self.err_user, self.err_pass, self.err_conf):
            e.set_text("")

    def _on_finish(self, *_):
        self._clear_errors()
        user = self.entry_user.get_text().strip().lower()
        pwd  = self.entry_pass.get_text()
        conf = self.entry_conf.get_text()
        ok   = True

        if not user:
            self.err_user.set_text("⚠  Ce champ est requis.")
            ok = False
        elif not user.replace("_", "").isalnum():
            self.err_user.set_text("⚠  Lettres, chiffres et _ uniquement.")
            ok = False
        elif user in ("root", "shark"):
            self.err_user.set_text("⚠  Nom réservé par le système.")
            ok = False

        if not pwd:
            self.err_pass.set_text("⚠  Le mot de passe est requis.")
            ok = False
        elif len(pwd) < 6:
            self.err_pass.set_text("⚠  6 caractères minimum.")
            ok = False

        if pwd and conf != pwd:
            self.err_conf.set_text("⚠  Les mots de passe ne correspondent pas.")
            ok = False

        if not ok:
            return

        self.username = user
        self.password = pwd
        self._go("loading")
        threading.Thread(target=self._apply_bg, daemon=True).start()

    def _build_loading(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)
        box.set_valign(Gtk.Align.CENTER)

        logo = self._logo_widget(size=72)
        box.pack_start(logo, False, False, 0)

        title = Gtk.Label(label="Configuration en cours…")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.CENTER)
        box.pack_start(title, False, False, 0)

        self.lbl_status = Gtk.Label(label="Initialisation…")
        self.lbl_status.get_style_context().add_class("page-subtitle")
        self.lbl_status.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.lbl_status, False, False, 0)

        self.pbar = Gtk.ProgressBar()
        self.pbar.set_size_request(460, -1)
        self.pbar.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.pbar, False, False, 8)

        box.pack_start(self._dots(2), False, False, 4)

        self._pulse_active = True
        GLib.timeout_add(70, self._pulse)

        self.stack.add_named(box, "loading")

    def _pulse(self):
        if self._pulse_active:
            self.pbar.pulse()
            return True
        return False

    def _set_status(self, txt):
        GLib.idle_add(self.lbl_status.set_text, txt)

    def _apply_bg(self):
        steps = [
            ("Configuration du clavier…",    self._step_keyboard),
            ("Création du compte…",           self._step_user),
            ("Personnalisation du bureau…",   self._step_home),
            ("Mise à jour de la session…",    self._step_lightdm),
            ("Finalisation…",                 self._step_final),
        ]
        for msg, fn in steps:
            self._set_status(msg)
            fn()
            time.sleep(0.45)
        self._pulse_active = False
        GLib.idle_add(self._go, "done")

    def _step_keyboard(self):
        subprocess.run(["localectl", "set-x11-keymap", self.selected_layout], capture_output=True)
        try:
            with open("/etc/default/keyboard", "w") as f:
                f.write(
                    f'XKBMODEL="pc105"\nXKBLAYOUT="{self.selected_layout}"\n'
                    f'XKBVARIANT=""\nXKBOPTIONS=""\n'
                )
        except Exception:
            pass

    def _step_user(self):
        subprocess.run(
            ["useradd", "-m", "-s", "/bin/zsh", "-G",
             "sudo,audio,video,plugdev,netdev", self.username],
            capture_output=True,
        )
        p = subprocess.Popen(["chpasswd"], stdin=subprocess.PIPE, text=True)
        p.communicate(input=f"{self.username}:{self.password}\n")

    def _step_home(self):
        home = f"/home/{self.username}"
        subprocess.run(["rsync", "-a", "/etc/skel/", f"{home}/"], capture_output=True)
        subprocess.run(["rsync", "-a", "/home/shark/", f"{home}/"], capture_output=True)
        subprocess.run(["chown", "-R", f"{self.username}:{self.username}", home], capture_output=True)

    def _step_lightdm(self):
        try:
            with open("/etc/lightdm/lightdm.conf") as f:
                content = f.read()
            lines = [
                f"autologin-user={self.username}" if "autologin-user=" in l else l
                for l in content.splitlines()
            ]
            with open("/etc/lightdm/lightdm.conf", "w") as f:
                f.write("\n".join(lines))
        except Exception:
            pass

    def _step_final(self):
        flag = f"/home/{self.username}/.config"
        os.makedirs(flag, exist_ok=True)
        with open(f"{flag}/sharkos-setup-done", "w") as f:
            f.write("done\n")
        subprocess.run(["chown", "-R", f"{self.username}:{self.username}", flag], capture_output=True)
        subprocess.run(["usermod", "-L", "shark"], capture_output=True)

    def _build_done(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)
        box.set_valign(Gtk.Align.CENTER)

        logo = self._logo_widget(size=100)
        box.pack_start(logo, False, False, 0)

        title = Gtk.Label(label="SharkOS est prêt !")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.CENTER)
        box.pack_start(title, False, False, 0)

        # Chip succès
        chip = Gtk.Label(label="✓  Installation réussie")
        chip.get_style_context().add_class("chip-success")
        chip.set_halign(Gtk.Align.CENTER)
        box.pack_start(chip, False, False, 0)

        self.lbl_done = Gtk.Label(
            label="Ton environnement a été configuré avec succès.\nRedémarrage automatique dans 3 secondes…"
        )
        self.lbl_done.get_style_context().add_class("page-subtitle")
        self.lbl_done.set_justify(Gtk.Justification.CENTER)
        self.lbl_done.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.lbl_done, False, False, 0)

        box.pack_start(self._sep(), False, False, 4)

        btn = Gtk.Button(label="Redémarrer maintenant")
        btn.get_style_context().add_class("btn-primary")
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect("clicked", self._reboot)
        box.pack_start(btn, False, False, 0)

        self._countdown = 3
        GLib.timeout_add_seconds(1, self._tick, btn)

        self.stack.add_named(box, "done")

    def _tick(self, btn):
        self._countdown -= 1
        if self._countdown <= 0:
            self._reboot()
            return False
        self.lbl_done.set_text(
            f"Ton environnement a été configuré avec succès.\n"
            f"Redémarrage automatique dans {self._countdown} seconde(s)…"
        )
        return True

    def _reboot(self, *_):
        self.close()
        subprocess.run(["systemctl", "restart", "lightdm"], capture_output=True)
        sys.exit(0)


if __name__ == "__main__":
    SharkOSSetupWizard()
    Gtk.main()
