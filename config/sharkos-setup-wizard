#!/usr/bin/env python3
# =============================================================================
# SharkOS — Assistant d'installation graphique (Style Apple / macOS)
# Permet de configurer le clavier, créer l'utilisateur et lancer la session.
# =============================================================================
import os
import sys
import subprocess
import threading
import time

try:
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk, GLib, Pango
except ImportError:
    print("[ERREUR] PyGObject ou GTK 3 manquant. L'interface ne peut pas se lancer.")
    sys.exit(1)

# Style CSS Inspiré d'Apple (Glassmorphism, sombre, boutons bleus néon, coins arrondis)
CSS_STYLE = b"""
