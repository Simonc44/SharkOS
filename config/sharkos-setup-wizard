    # ── PAGE 2 : Keyboard ────────────────────────────────────────────

    def _mk_keyboard(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)

        # Header : logo petit + titre
        hdr = Gtk.Box(spacing=14)
        hdr.pack_start(self._logo(size=40), False, False, 0)
        t = self._lbl("Disposition du clavier", "page-title")
        t.set_halign(Gtk.Align.START)
        hdr.pack_start(t, True, True, 0)
        box.pack_start(hdr, False, False, 0)

        sub = self._lbl(
            "Choisis le layout qui correspond à ton clavier physique.",
            "subtitle"
        )
        sub.set_halign(Gtk.Align.START)
        box.pack_start(sub, False, False, 0)

        box.pack_start(self._sep(), False, False, 0)

        # ComboBox
        self.combo = Gtk.ComboBoxText()
        for name, code in KEYBOARDS:
            self.combo.append(code, name)
        self.combo.set_active(0)
        self.combo.connect("changed", self._on_layout)
        box.pack_start(self._field_group("Langue / Layout", self.combo), False, False, 0)

        # Badge code actuel
        row = Gtk.Box(spacing=10)
        row.set_halign(Gtk.Align.START)
        row.pack_start(self._lbl("Sélectionné :", "subtitle"), False, False, 0)
        self.badge = self._lbl("fr", "badge")
        row.pack_start(self.badge, False, False, 0)
        box.pack_start(row, False, False, 0)

        box.pack_start(self._dots(0), False, False, 8)

        btn = Gtk.Button(label="Continuer  →")
        btn.get_style_context().add_class("btn-primary")
        btn.connect("clicked", lambda *_: self._go("user"))
        box.pack_start(self._nav(
            back=lambda *_: self._go("welcome"),
            fwd=btn,
        ), False, False, 0)

        self.stack.add_named(box, "keyboard")

    def _on_layout(self, combo):
        self.layout = combo.get_active_id() or "fr"
        self.badge.set_text(self.layout)
        subprocess.run(["setxkbmap", self.layout], capture_output=True)

