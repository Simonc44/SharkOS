# =============================================================================
# HELPER : créer un utilisateur et lui définir un mot de passe
# BUG FIX : on utilise shadow hashing correct + on vérifie l'existence
# =============================================================================
def create_user(username, password):
    """
    Crée l'utilisateur (s'il n'existe pas) et définit son mot de passe
    de façon robuste avec chpasswd (évite les bugs de crypt()).
    """
    # Vérifier si l'utilisateur existe déjà
    r = subprocess.run(["id", username], capture_output=True)
    if r.returncode != 0:
        # Créer l'utilisateur
        subprocess.run([
            "useradd", "-m", "-s", "/bin/bash",
            "-G", "sudo,audio,video,plugdev,netdev",
            username
        ], capture_output=True)

    # Définir le mot de passe via chpasswd (le plus fiable)
    proc = subprocess.Popen(
        ["chpasswd"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    out, err = proc.communicate(input=f"{username}:{password}\n".encode())

    # Si chpasswd échoue, tenter avec passwd --stdin
    if proc.returncode != 0:
        proc2 = subprocess.Popen(
            ["passwd", "--stdin", username],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        proc2.communicate(input=f"{password}\n".encode())

    # Fallback ultime : openssl + usermod
    if proc.returncode != 0:
        hashed = subprocess.check_output(
            ["openssl", "passwd", "-6", password]
        ).decode().strip()
        subprocess.run(["usermod", "-p", hashed, username], capture_output=True)

    return proc.returncode == 0


class Wizard(Gtk.Window):

    def __init__(self):
        super().__init__(title="SharkOS")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.set_decorated(False)
        self.fullscreen()

        # CSS
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.layout = "fr"
        self.username = ""
        self.password = ""
        self._pulse_active = False
        self._countdown = 3

        # Fond foncé + overlay glow bleu
        outer = Gtk.Overlay()
        self.add(outer)

        bg = Gtk.EventBox()
        outer.add(bg)

        glow = Gtk.Box()
        # Léger halo bleu en bas à droite
        glow.set_halign(Gtk.Align.FILL)
        glow.set_valign(Gtk.Align.FILL)
        outer.add_overlay(glow)

        # Centrage
        center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        center.set_valign(Gtk.Align.CENTER)
        center.set_halign(Gtk.Align.CENTER)
        outer.add_overlay(center)

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.card.get_style_context().add_class("glass-card")
        self.card.set_size_request(760, -1)
        center.pack_start(self.card, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(350)
        self.card.pack_start(self.stack, True, True, 0)

        self._mk_welcome()
        self._mk_keyboard()
        self._mk_user()
        self._mk_loading()
        self._mk_done()

        self.stack.set_visible_child_name("welcome")
        self.show_all()

    # ── Utilitaires ───────────────────────────────────────────────────

    def _logo(self, size=96):
        for path in LOGO_PATHS:
            if os.path.exists(path):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size)
                    img = Gtk.Image.new_from_pixbuf(pb)
                    img.set_halign(Gtk.Align.CENTER)
                    return img
                except Exception:
                    pass
        # Fallback emoji
        lbl = Gtk.Label(label="🦈")
        lbl.modify_font(Pango.FontDescription("Sans 64"))
        lbl.set_halign(Gtk.Align.CENTER)
        return lbl

    def _dots(self, active=-1, n=3):
        box = Gtk.Box(spacing=10)
        box.set_halign(Gtk.Align.CENTER)
        for i in range(n):
            d = Gtk.Label(label="●")
            d.get_style_context().add_class("dot-on" if i == active else "dot-off")
            box.pack_start(d, False, False, 0)
        return box

    def _sep(self):
        s = Gtk.Box()
        s.set_size_request(-1, 1)
        s.get_style_context().add_class("glass-sep")
        return s

    def _lbl(self, text, cls):
        l = Gtk.Label(label=text)
        l.get_style_context().add_class(cls)
        return l

    def _field_group(self, label_text, widget, err=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        lbl = Gtk.Label(label=label_text)
        lbl.get_style_context().add_class("field-label")
        lbl.set_halign(Gtk.Align.START)
        box.pack_start(lbl, False, False, 0)
        box.pack_start(widget, False, False, 0)
        if err:
            box.pack_start(err, False, False, 0)
        return box

    def _nav(self, back=None, fwd=None):
        box = Gtk.Box(spacing=12)
        box.set_halign(Gtk.Align.END)
        if back:
            b = Gtk.Button(label="← Retour")
            b.get_style_context().add_class("btn-secondary")
            b.connect("clicked", back)
            box.pack_start(b, False, False, 0)
        if fwd:
            box.pack_start(fwd, False, False, 0)
        return box

    def _go(self, name):
        self.stack.set_visible_child_name(name)

    # ── PAGE 1 : Welcome ─────────────────────────────────────────────

