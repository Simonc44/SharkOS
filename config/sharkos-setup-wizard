import sys
import subprocess
import threading
import time

try:
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk, GLib, Pango
except ImportError:
    print("[ERREUR] PyGObject ou GTK 3 manquant.")
    sys.exit(1)

