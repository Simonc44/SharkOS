KEYBOARDS = [
    ("🇫🇷  Français (AZERTY)", "fr"),
    ("🇺🇸  English — US (QWERTY)", "us"),
    ("🇬🇧  English — UK (QWERTY)", "gb"),
    ("🇩🇪  Deutsch (QWERTZ)", "de"),
    ("🇪🇸  Español (QWERTY)", "es"),
    ("🇮🇹  Italiano (QWERTY)", "it"),
    ("🇵🇹  Português (QWERTY)", "pt"),
    ("🇧🇪  Belge (AZERTY)", "be"),
    ("🇨🇭  Suisse (QWERTZ)", "ch"),
]

PAGES = ["welcome", "keyboard", "user", "loading", "done"]


class SharkOSSetupWizard(Gtk.Window):
    def __init__(self):
        super().__init__(title="SharkOS — Assistant de configuration")
        self.set_default_size(860, 600)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.fullscreen()

        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(CSS_STYLE)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.selected_layout = "fr"
        self.username = ""
        self.password = ""
        self.current_page_index = 0

        # Wrapper plein écran centré
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.set_valign(Gtk.Align.CENTER)
        outer.set_halign(Gtk.Align.CENTER)
        self.add(outer)

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.card.get_style_context().add_class("main-card")
        self.card.set_size_request(720, -1)
        outer.pack_start(self.card, False, False, 0)

        # Stack
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(400)
        self.card.pack_start(self.stack, True, True, 0)

        self._build_welcome()
        self._build_keyboard()
        self._build_user()
        self._build_loading()
        self._build_done()

        self.stack.set_visible_child_name("welcome")
        self.show_all()

    # ── helpers ──────────────────────────────────────────────────────────────

    def _dots(self, active_index, total=3):
        """Renvoie un widget de dots de progression."""
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_halign(Gtk.Align.CENTER)
        for i in range(total):
            lbl = Gtk.Label(label="●")
            if i == active_index:
                lbl.get_style_context().add_class("step-dot-active")
            else:
                lbl.get_style_context().add_class("step-dot")
            box.pack_start(lbl, False, False, 0)
        return box

    def _field_block(self, label_text, widget, error_label=None):
        """Groupe label + champ + (optionnel) erreur."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl = Gtk.Label(label=label_text)
        lbl.get_style_context().add_class("field-label")
        lbl.set_halign(Gtk.Align.START)
        box.pack_start(lbl, False, False, 0)
        box.pack_start(widget, False, False, 0)
        if error_label:
            box.pack_start(error_label, False, False, 0)
        return box

    def _nav_box(self, back_cb=None, next_btn=None):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        box.set_halign(Gtk.Align.END)
        if back_cb:
            btn = Gtk.Button(label="← Retour")
            btn.get_style_context().add_class("btn-secondary")
            btn.connect("clicked", back_cb)
            box.pack_start(btn, False, False, 0)
        if next_btn:
            box.pack_start(next_btn, False, False, 0)
        return box

    def _go(self, name):
        self.stack.set_visible_child_name(name)

    # ── pages ─────────────────────────────────────────────────────────────────

    def _build_welcome(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)

        # Logo
        logo = Gtk.Label(label="🦈")
        logo.modify_font(Pango.FontDescription("Sans 80"))
        logo.set_halign(Gtk.Align.CENTER)
        box.pack_start(logo, False, False, 0)

        # Titre
        title = Gtk.Label(label="Bienvenue dans SharkOS")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.CENTER)
        box.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label="Configurons ton système en 3 étapes.\nCela prend moins d'une minute."
        )
        subtitle.get_style_context().add_class("page-subtitle")
        subtitle.set_justify(Gtk.Justification.CENTER)
        subtitle.set_halign(Gtk.Align.CENTER)
        box.pack_start(subtitle, False, False, 0)

        # Dots (étape 0 sur 3, donc aucun actif — on est avant les étapes)
        box.pack_start(self._dots(-1), False, False, 8)

        btn = Gtk.Button(label="Commencer  →")
        btn.get_style_context().add_class("btn-primary")
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_: self._go("keyboard"))
        box.pack_start(btn, False, False, 8)

        self.stack.add_named(box, "welcome")

    def _build_keyboard(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)

        box.pack_start(self._dots(0), False, False, 0)

        title = Gtk.Label(label="Disposition du clavier")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.START)
        box.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(label="Choisis le layout qui correspond à ton clavier physique.")
        subtitle.get_style_context().add_class("page-subtitle")
        subtitle.set_halign(Gtk.Align.START)
        box.pack_start(subtitle, False, False, 4)

        # Séparateur
        sep = Gtk.Separator()
        sep.get_style_context().add_class("divider")
        box.pack_start(sep, False, False, 4)

        self.combo = Gtk.ComboBoxText()
        for name, code in KEYBOARDS:
            self.combo.append(code, name)
        self.combo.set_active(0)
        self.combo.connect("changed", self._on_keyboard_changed)
        box.pack_start(self._field_block("Langue du clavier", self.combo), False, False, 0)

        # Aperçu du layout sélectionné
        self.lbl_layout_preview = Gtk.Label(label="Disposition sélectionnée : fr")
        self.lbl_layout_preview.get_style_context().add_class("page-subtitle")
        self.lbl_layout_preview.set_halign(Gtk.Align.START)
        box.pack_start(self.lbl_layout_preview, False, False, 0)

        btn_next = Gtk.Button(label="Continuer  →")
        btn_next.get_style_context().add_class("btn-primary")
        box.pack_start(
            self._nav_box(
                back_cb=lambda *_: self._go("welcome"),
                next_btn=btn_next,
            ),
            False, False, 16,
        )
        btn_next.connect("clicked", lambda *_: self._go("user"))

        self.stack.add_named(box, "keyboard")

    def _on_keyboard_changed(self, combo):
        self.selected_layout = combo.get_active_id() or "fr"
        self.lbl_layout_preview.set_text(f"Disposition sélectionnée : {self.selected_layout}")
        subprocess.run(["setxkbmap", self.selected_layout], capture_output=True)

    def _build_user(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)

        box.pack_start(self._dots(1), False, False, 0)

        title = Gtk.Label(label="Créer ton compte")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.START)
        box.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(label="Ce compte aura les droits sudo. Tu pourras en créer d'autres après.")
        subtitle.get_style_context().add_class("page-subtitle")
        subtitle.set_halign(Gtk.Align.START)
        box.pack_start(subtitle, False, False, 4)

        sep = Gtk.Separator()
        sep.get_style_context().add_class("divider")
        box.pack_start(sep, False, False, 4)

        # Nom d'utilisateur
        self.entry_username = Gtk.Entry()
        self.entry_username.set_placeholder_text("Ex : sharky")
        self.err_username = Gtk.Label()
        self.err_username.get_style_context().add_class("error-label")
        self.err_username.set_halign(Gtk.Align.START)
        box.pack_start(
            self._field_block("Nom d'utilisateur", self.entry_username, self.err_username),
            False, False, 0,
        )

        # Mot de passe avec bouton œil
        pass_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.entry_password = Gtk.Entry()
        self.entry_password.set_visibility(False)
        self.entry_password.set_placeholder_text("Mot de passe")
        pass_row.pack_start(self.entry_password, True, True, 0)
        btn_eye = Gtk.Button(label="👁")
        btn_eye.set_relief(Gtk.ReliefStyle.NONE)
        btn_eye.connect("clicked", lambda *_: self.entry_password.set_visibility(
            not self.entry_password.get_visibility()
        ))
        pass_row.pack_start(btn_eye, False, False, 0)
        self.err_password = Gtk.Label()
        self.err_password.get_style_context().add_class("error-label")
        self.err_password.set_halign(Gtk.Align.START)
        box.pack_start(
            self._field_block("Mot de passe", pass_row, self.err_password),
            False, False, 0,
        )

        # Confirmation
        self.entry_confirm = Gtk.Entry()
        self.entry_confirm.set_visibility(False)
        self.entry_confirm.set_placeholder_text("Répéter le mot de passe")
        self.err_confirm = Gtk.Label()
        self.err_confirm.get_style_context().add_class("error-label")
        self.err_confirm.set_halign(Gtk.Align.START)
        box.pack_start(
            self._field_block("Confirmer le mot de passe", self.entry_confirm, self.err_confirm),
            False, False, 0,
        )

        btn_finish = Gtk.Button(label="Finaliser  →")
        btn_finish.get_style_context().add_class("btn-primary")
        btn_finish.connect("clicked", self._on_finish)
        box.pack_start(
            self._nav_box(
                back_cb=lambda *_: self._go("keyboard"),
                next_btn=btn_finish,
            ),
            False, False, 4,
        )

        self.stack.add_named(box, "user")

    def _clear_errors(self):
        for lbl in (self.err_username, self.err_password, self.err_confirm):
            lbl.set_text("")

    def _on_finish(self, *_):
        self._clear_errors()
        username = self.entry_username.get_text().strip().lower()
        password = self.entry_password.get_text()
        confirm = self.entry_confirm.get_text()
        ok = True

        if not username:
            self.err_username.set_text("⚠ Ce champ est requis.")
            ok = False
        elif not username.replace("_", "").isalnum():
            self.err_username.set_text("⚠ Lettres, chiffres et _ uniquement.")
            ok = False
        elif username in ("root", "shark"):
            self.err_username.set_text("⚠ Nom réservé par le système.")
            ok = False

        if not password:
            self.err_password.set_text("⚠ Le mot de passe est requis.")
            ok = False
        elif len(password) < 6:
            self.err_password.set_text("⚠ 6 caractères minimum.")
            ok = False

        if password and confirm != password:
            self.err_confirm.set_text("⚠ Les mots de passe ne correspondent pas.")
            ok = False

        if not ok:
            return

        self.username = username
        self.password = password
        self._go("loading")
        threading.Thread(target=self._apply_bg, daemon=True).start()

    def _build_loading(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_valign(Gtk.Align.CENTER)

        box.pack_start(self._dots(2), False, False, 0)

        title = Gtk.Label(label="Application des paramètres…")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.CENTER)
        box.pack_start(title, False, False, 0)

        self.lbl_status = Gtk.Label(label="Initialisation…")
        self.lbl_status.get_style_context().add_class("page-subtitle")
        self.lbl_status.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.lbl_status, False, False, 0)

        self.pbar = Gtk.ProgressBar()
        self.pbar.set_size_request(400, -1)
        self.pbar.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.pbar, False, False, 8)

        self._pulse_active = True
        GLib.timeout_add(80, self._pulse)

        self.stack.add_named(box, "loading")

    def _pulse(self):
        if self._pulse_active:
            self.pbar.pulse()
            return True
        return False

    def _set_status(self, txt):
        GLib.idle_add(self.lbl_status.set_text, txt)

    def _apply_bg(self):
        steps = [
            ("Configuration du clavier…",       self._step_keyboard),
            (f"Création de l'utilisateur…",      self._step_user),
            ("Personnalisation du bureau…",       self._step_home),
            ("Mise à jour de LightDM…",           self._step_lightdm),
            ("Finalisation…",                     self._step_final),
        ]
        for msg, fn in steps:
            self._set_status(msg)
            fn()
            time.sleep(0.4)

        self._pulse_active = False
        GLib.idle_add(self._go, "done")

    def _step_keyboard(self):
        subprocess.run(["localectl", "set-x11-keymap", self.selected_layout], capture_output=True)
        try:
            with open("/etc/default/keyboard", "w") as f:
                f.write(f'XKBMODEL="pc105"\nXKBLAYOUT="{self.selected_layout}"\nXKBVARIANT=""\nXKBOPTIONS=""\n')
        except Exception:
            pass

    def _step_user(self):
        subprocess.run(
            ["useradd", "-m", "-s", "/bin/zsh", "-G", "sudo,audio,video,plugdev,netdev", self.username],
            capture_output=True,
        )
        p = subprocess.Popen(["chpasswd"], stdin=subprocess.PIPE, text=True)
        p.communicate(input=f"{self.username}:{self.password}\n")

    def _step_home(self):
        subprocess.run(["rsync", "-a", "/etc/skel/", f"/home/{self.username}/"], capture_output=True)
        subprocess.run(["rsync", "-a", "/home/shark/", f"/home/{self.username}/"], capture_output=True)
        subprocess.run(["chown", "-R", f"{self.username}:{self.username}", f"/home/{self.username}"], capture_output=True)

    def _step_lightdm(self):
        try:
            with open("/etc/lightdm/lightdm.conf") as f:
                content = f.read()
            content = "\n".join(
                f"autologin-user={self.username}" if "autologin-user=" in line else line
                for line in content.splitlines()
            )
            with open("/etc/lightdm/lightdm.conf", "w") as f:
                f.write(content)
        except Exception:
            pass

    def _step_final(self):
        flag_dir = f"/home/{self.username}/.config"
        os.makedirs(flag_dir, exist_ok=True)
        with open(f"{flag_dir}/sharkos-setup-done", "w") as f:
            f.write("done\n")
        subprocess.run(["chown", "-R", f"{self.username}:{self.username}", flag_dir], capture_output=True)
        subprocess.run(["usermod", "-L", "shark"], capture_output=True)

    def _build_done(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_valign(Gtk.Align.CENTER)

        check = Gtk.Label(label="✅")
        check.modify_font(Pango.FontDescription("Sans 72"))
        check.set_halign(Gtk.Align.CENTER)
        box.pack_start(check, False, False, 0)

        title = Gtk.Label(label="SharkOS est prêt !")
        title.get_style_context().add_class("page-title")
        title.set_halign(Gtk.Align.CENTER)
        box.pack_start(title, False, False, 0)

        self.lbl_done_sub = Gtk.Label(label="Ton environnement a été configuré.\nRedémarrage de la session dans 3 secondes…")
        self.lbl_done_sub.get_style_context().add_class("page-subtitle")
        self.lbl_done_sub.set_justify(Gtk.Justification.CENTER)
        self.lbl_done_sub.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.lbl_done_sub, False, False, 0)

        btn = Gtk.Button(label="Redémarrer maintenant")
        btn.get_style_context().add_class("btn-primary")
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect("clicked", self._reboot)
        box.pack_start(btn, False, False, 12)

        # Countdown auto
        self._countdown = 3
        GLib.timeout_add_seconds(1, self._tick_countdown, btn)

        self.stack.add_named(box, "done")

    def _tick_countdown(self, btn):
        self._countdown -= 1
        if self._countdown <= 0:
            self._reboot()
            return False
        self.lbl_done_sub.set_text(
            f"Ton environnement a été configuré.\nRedémarrage de la session dans {self._countdown} seconde(s)…"
        )
        return True

    def _reboot(self, *_):
        self.close()
        subprocess.run(["systemctl", "restart", "lightdm"], capture_output=True)
        sys.exit(0)


if __name__ == "__main__":
    SharkOSSetupWizard()
    Gtk.main()
