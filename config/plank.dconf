# =============================================================================
# SharkOS — Plank Dock Liquid Glass
# =============================================================================

[docks/dock1]
position='bottom'
alignment='center'
hide-mode='intellihide'
unhide-delay=0
hide-delay=250
icon-size=52
zoom-enabled=true
zoom-percent=145
# Thème custom SharkOS (généré par le hook 20)
theme='SharkOS'
lock-items=false
offset=4
monitor=''
items-filename=['thunar.dockitem', 'terminal.dockitem', 'firefox.dockitem', 'mousepad.dockitem', 'wireshark.dockitem', 'clamtk.dockitem', 'gufw.dockitem']
