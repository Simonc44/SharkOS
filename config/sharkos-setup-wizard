        btn.get_style_context().add_class("btn-primary")
        btn.connect("clicked", self._on_finish)
        box.pack_start(self._nav(
            back=lambda *_: self._go("keyboard"),
            fwd=btn,
        ), False, False, 0)

        self.stack.add_named(box, "user")

    def _clear_errs(self):
        for e in (self.err_user, self.err_pass, self.err_conf):
            e.set_text("")

    def _on_finish(self, *_):
        self._clear_errs()
        user = self.e_user.get_text().strip().lower()
        pwd  = self.e_pass.get_text()
        conf = self.e_conf.get_text()
        ok   = True

        if not user:
            self.err_user.set_text("⚠  Ce champ est requis.")
            ok = False
        elif len(user) < 2:
            self.err_user.set_text("⚠  Minimum 2 caractères.")
            ok = False
        elif not all(c.isalnum() or c == '_' for c in user):
            self.err_user.set_text("⚠  Lettres, chiffres et _ uniquement.")
            ok = False
        elif user in ("root", "shark", "daemon", "bin", "sys", "nobody"):
            self.err_user.set_text("⚠  Nom réservé par le système.")
            ok = False

        if not pwd:
            self.err_pass.set_text("⚠  Le mot de passe est requis.")
            ok = False
        elif len(pwd) < 6:
            self.err_pass.set_text("⚠  6 caractères minimum.")
            ok = False

        if pwd and conf != pwd:
            self.err_conf.set_text("⚠  Les mots de passe ne correspondent pas.")
            ok = False

        if not ok:
            return

        self.username = user
        self.password = pwd
        self._go("loading")
        threading.Thread(target=self._apply, daemon=True).start()

    # ── PAGE 4 : Loading ─────────────────────────────────────────────

    def _mk_loading(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_valign(Gtk.Align.CENTER)

        logo = self._logo(size=80)
        logo.set_margin_bottom(8)
        box.pack_start(logo, False, False, 0)

        t = self._lbl("Configuration en cours…", "page-title")
        t.set_halign(Gtk.Align.CENTER)
        box.pack_start(t, False, False, 0)

        self.lbl_status = self._lbl("Initialisation…", "subtitle")
        self.lbl_status.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.lbl_status, False, False, 0)

        self.pbar = Gtk.ProgressBar()
        self.pbar.set_size_request(480, -1)
        self.pbar.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.pbar, False, False, 0)

        box.pack_start(self._dots(2), False, False, 4)

        self._pulse_active = True
        GLib.timeout_add(70, self._pulse)

        self.stack.add_named(box, "loading")

    def _pulse(self):
        if self._pulse_active:
            self.pbar.pulse()
            return True
        return False

    def _status(self, txt):
        GLib.idle_add(self.lbl_status.set_text, txt)

    def _apply(self):
        """Thread background — applique toute la configuration."""
        steps = [
            ("Configuration du clavier…",   self._step_keyboard),
            ("Création du compte…",          self._step_user),
            ("Copie du profil…",             self._step_home),
            ("Configuration de la session…", self._step_session),
            ("Finalisation…",                self._step_final),
        ]
        for msg, fn in steps:
            self._status(msg)
            fn()
            time.sleep(0.4)

        self._pulse_active = False
        GLib.idle_add(self._go, "done")

    def _step_keyboard(self):
        subprocess.run(["localectl", "set-x11-keymap", self.layout],
                       capture_output=True)
        try:
            with open("/etc/default/keyboard", "w") as f:
                f.write(
                    f'XKBMODEL="pc105"\nXKBLAYOUT="{self.layout}"\n'
                    f'XKBVARIANT=""\nXKBOPTIONS=""\n'
                )
        except Exception:
            pass

    def _step_user(self):
        """
        BUG FIX PRINCIPAL : création + mot de passe robuste.
        On utilise create_user() qui essaie chpasswd, passwd --stdin,
        puis openssl en fallback.
        """
        create_user(self.username, self.password)

    def _step_home(self):
        home = f"/home/{self.username}"
        # Copier skel (configuration de base)
        subprocess.run(["rsync", "-a", "--ignore-existing",
                        "/etc/skel/", f"{home}/"], capture_output=True)
        # Changer le propriétaire
        subprocess.run(["chown", "-R",
                        f"{self.username}:{self.username}", home],
                       capture_output=True)
        # Définir le shell en zsh si disponible
        zsh = subprocess.run(["which", "zsh"],
                             capture_output=True, text=True).stdout.strip()
        if zsh:
            subprocess.run(["usermod", "-s", zsh, self.username],
                           capture_output=True)

    def _step_session(self):
        """Met à jour LightDM pour autologin avec le nouvel utilisateur.

        BUG FIX : le hook 50-sharkos-finalize.sh écrit l'autologin dans
        /etc/lightdm/lightdm.conf.d/50-sharkos-autologin.conf, qui est
        PRIORITAIRE sur /etc/lightdm/lightdm.conf. Si le wizard ne modifie
        que le fichier principal, LightDM continue d'autolog-iner 'shark'
        — or _step_final verrouille ce compte (usermod -L shark) → échec au
        reboot. On met donc à jour les DEUX fichiers.
        """
        lightdm_conf = "/etc/lightdm/lightdm.conf"
        autologin_dropin = "/etc/lightdm/lightdm.conf.d/50-sharkos-autologin.conf"

        def _set_autologin(path):
            try:
                lines = open(path).readlines()
            except Exception:
                lines = [
                    "[Seat:*]\n",
                    "autologin-user=shark\n",
                    "autologin-user-timeout=0\n",
                    "autologin-session=xfce\n",
                ]
            new_lines = []
            seen = False
            for line in lines:
                if line.startswith("autologin-user=") and not line.strip().startswith("#"):
                    new_lines.append(f"autologin-user={self.username}\n")
                    seen = True
                else:
                    new_lines.append(line)
            if not seen:
                # Injection si le [Seat:*] existe déjà
                try:
                    idx = next(i for i, l in enumerate(new_lines)
                               if l.strip() == "[Seat:*]")
                    new_lines.insert(idx + 1, f"autologin-user={self.username}\n")
                except StopIteration:
                    new_lines += [f"autologin-user={self.username}\n"]
            try:
                with open(path, "w") as f:
                    f.writelines(new_lines)
            except Exception:
                pass

        _set_autologin(lightdm_conf)
        _set_autologin(autologin_dropin)

        # Le nouvel utilisateur doit être membre du groupe 'autologin' pour
        # que la règle PAM pam_succeed_if (hook 50) le laisse entrer sans
        # mot de passe.
        subprocess.run(["usermod", "-aG", "autologin", self.username],
                       capture_output=True)

    def _step_final(self):
        # Marquer la config comme faite
        flag = f"/home/{self.username}/.config"
        os.makedirs(flag, exist_ok=True)
        with open(f"{flag}/sharkos-setup-done", "w") as f:
            f.write("done\n")
        subprocess.run(["chown", "-R",
                        f"{self.username}:{self.username}", flag],
                       capture_output=True)
        # Désactiver le compte shark (live) — optionnel
        subprocess.run(["usermod", "-L", "shark"], capture_output=True)

    # ── PAGE 5 : Done ────────────────────────────────────────────────

    def _mk_done(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_valign(Gtk.Align.CENTER)

        logo = self._logo(size=100)
        logo.set_margin_bottom(4)
        box.pack_start(logo, False, False, 0)

        t = self._lbl("SharkOS est prêt !", "page-title")
        t.set_halign(Gtk.Align.CENTER)
        box.pack_start(t, False, False, 0)

        chip = self._lbl("✓  Compte créé avec succès", "chip-ok")
        chip.set_halign(Gtk.Align.CENTER)
        box.pack_start(chip, False, False, 0)

        self.lbl_done = self._lbl(
            "Redémarrage de la session dans 3 secondes…",
            "subtitle"
        )
        self.lbl_done.set_justify(Gtk.Justification.CENTER)
        self.lbl_done.set_halign(Gtk.Align.CENTER)
        box.pack_start(self.lbl_done, False, False, 0)

        box.pack_start(self._sep(), False, False, 0)

        btn = Gtk.Button(label="Redémarrer maintenant")
        btn.get_style_context().add_class("btn-primary")
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect("clicked", self._reboot)
        box.pack_start(btn, False, False, 0)

        self._countdown = 3
        GLib.timeout_add_seconds(1, self._tick)

        self.stack.add_named(box, "done")

    def _tick(self):
        self._countdown -= 1
        if self._countdown <= 0:
            self._reboot()
            return False
        GLib.idle_add(
            self.lbl_done.set_text,
            f"Redémarrage de la session dans {self._countdown} seconde(s)…"
        )
        return True

    def _reboot(self, *_):
        self.close()
        subprocess.run(["systemctl", "restart", "lightdm"], capture_output=True)
        sys.exit(0)


